(* Reuse (I5): a decision that reads the state, a transition that grows it
   ======================================================================= *)

[@@@import Core, "core.iml"]
[@@@import Freshness, "freshness.iml"]

open Core
open Artifact
open Trace

(* The reuse decision (formalization-cache `planFormalization`) reads the state: is
   there already a live (current, non-superseded) verification result for the target
   that is fresh against the current model? If so, Reuse it (a cache hit); otherwise,
   if the target is in scope, Formalize (a miss); otherwise Skip. This composes the
   freshness query (I4) above with the append transition (I1). *)
type reuse_action = Reuse | Formalize | Skip

let plan_reuse (t : trace) (tgt : int) (in_scope : bool)
               (present : int -> bool) (cur : int -> int) : reuse_action =
  if not in_scope then Skip
  else if Freshness.has_fresh_result t tgt present cur then Reuse
  else Formalize

(* applying the plan: a miss appends the freshly-produced result; a hit or a skip leaves
   the state untouched. [a_new] is the artifact a Formalize would produce. *)
let apply_reuse (t : trace) (a_new : artifact) (act : reuse_action) : trace =
  match act with
  | Formalize -> extend t a_new
  | Reuse -> t
  | Skip -> t

(* I5a never-reuse-stale: the plan says Reuse only when a live fresh result exists, so
   drifted evidence is never trusted. *)
theorem never_reuse_stale (t : trace) (tgt : int) (in_scope : bool)
                          (present : int -> bool) (cur : int -> int) =
  plan_reuse t tgt in_scope present cur = Reuse
  ==> Freshness.has_fresh_result t tgt present cur
[@@by auto]

(* I5b conditional growth: applying the plan grows the trace by at most one. *)
theorem conditional_growth (t : trace) (a_new : artifact) (act : reuse_action) =
  length (apply_reuse t a_new act) = length t
  || length (apply_reuse t a_new act) = length t + 1
[@@by [%use length_append_one t a_new] @> auto]

(* I5c only a miss appends: the trace grows exactly when the decision was Formalize; Reuse and
   Skip are exact no-ops on the state. *)
theorem only_miss_appends (t : trace) (a_new : artifact) (act : reuse_action) =
  (length (apply_reuse t a_new act) = length t + 1) = (act = Formalize)
[@@by [%use length_append_one t a_new] @> auto]

(* I5d the reuse transition is safe: it preserves the machine invariant. A miss
   appends an admissible artifact (extend preserves wf); a hit or a skip changes nothing. *)
theorem apply_reuse_preserves_wf (t : trace) (a_new : artifact) (act : reuse_action) =
  wf t && (act = Formalize ==> admissible t a_new) ==> wf (apply_reuse t a_new act)
[@@by [%use extend_preserves_wf t a_new] @> auto]

(* I5e composition with freshness (revert-reuses): if a live result for [tgt] is fresh
   against the current model (e.g. an edit was reverted, so the fingerprint matches
   again), the in-scope plan is Reuse, and Reuse does not grow the trace. *)
theorem revert_reuses (t : trace) (tgt : int) (present : int -> bool) (cur : int -> int) =
  Freshness.has_fresh_result t tgt present cur
  ==> plan_reuse t tgt true present cur = Reuse
      && length (apply_reuse t (List.hd t) Reuse) = length t
[@@by auto]

(* Reuse on the full state
   -----------------------

   The same decision and step with the action log. A miss records the formalizing
   action and the result it produces (extend_state); a hit or a skip changes nothing. *)

open State

let plan_reuse_state (s : state) (tgt : int) (in_scope : bool)
                     (present : int -> bool) (cur : int -> int) : reuse_action =
  plan_reuse s.artifacts tgt in_scope present cur

let apply_reuse_state (s : state) (act0 : action) (a_new : artifact) (act : reuse_action)
    : state =
  match act with
  | Formalize -> extend_state s act0 a_new
  | Reuse -> s
  | Skip -> s

(* the artifacts move exactly as in apply_reuse *)
theorem apply_reuse_state_artifacts (s : state) (act0 : action) (a_new : artifact)
    (act : reuse_action) =
  (apply_reuse_state s act0 a_new act).artifacts = apply_reuse s.artifacts a_new act
[@@by auto]

(* I5f the reuse step on the full state preserves wf_state: a miss is an admissible
   extend_state; a hit or a skip leaves the state as it is. *)
theorem apply_reuse_state_preserves_wf (s : state) (act0 : action) (a_new : artifact)
    (act : reuse_action) =
  wf_state s && (act = Formalize ==> admissible_state s act0 a_new)
  ==> wf_state (apply_reuse_state s act0 a_new act)
[@@by [%use extend_state_preserves_wf s act0 a_new] @> auto]
[@@disable wf_state, admissible_state, extend_state]
