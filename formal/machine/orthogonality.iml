(* Orthogonality: governed and met are independent
   ================================================

   The full state is (artifacts, timeline); the two axes read disjoint parts. *)

[@@@import Machine, "machine.iml"]
[@@@import Goals, "goals.iml"]
[@@@import Policy, "policy.iml"]

open Machine

type gstate = { arts : trace; tl : Policy.timeline }

let met_of (s : gstate) (g : Goals.gitem list) : bool = Goals.goal_met s.arts g

let governed_of (s : gstate) (trig : Policy.act -> bool) (resp : Policy.act -> bool) : bool =
  Policy.responds trig resp s.tl

(* P3 orthogonality, half 1: no change to the action timeline changes the met verdict.
   How the work was sequenced cannot change what was established. *)
theorem met_ignores_timeline (s : gstate) (g : Goals.gitem list) (new_tl : Policy.timeline) =
  met_of s g = met_of { s with tl = new_tl } g
[@@by auto]

(* P4 orthogonality, half 2: no change to the artifacts changes the governed verdict,
   because the process constraint reads only the timeline. With P3 this proves the
   claim that governed is independent of met. *)
theorem governed_ignores_arts (s : gstate) (trig : Policy.act -> bool) (resp : Policy.act -> bool) (new_arts : trace) =
  governed_of s trig resp = governed_of { s with arts = new_arts } trig resp
[@@by auto]
