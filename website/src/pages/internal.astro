---
import Layout from "../layouts/Layout.astro";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

// Internal Goal Contract gallery — worked examples spanning the model. The manifest is generated by
// examples/make_goal_gallery.py (which also bakes in each example's resolved met/governed/certified),
// and prepare.mjs syncs the trace files to public/viewer/demo-traces/goal-contract/ so each opens in
// the viewer via ?trace=. Not linked from the public nav — reach it directly at /internal.
let manifest = { groups: [] };
try {
  manifest = JSON.parse(readFileSync(resolve("../examples/goal-contract/manifest.json"), "utf8"));
} catch (e) { /* generated at build; empty if missing */ }

const total = manifest.groups.reduce((n, g) => n + g.examples.length, 0);
const viewer = (file) => `/viewer/visualizer.html?trace=demo-traces/goal-contract/${file}`;

// Axis badge: true → green ✓, false → red ✗, null (no policy declared) → grey –.
function axis(label, v) {
  if (v === null || v === undefined) return { label, cls: "na", mark: "–" };
  return { label, cls: v ? "ok" : "no", mark: v ? "✓" : "✗" };
}
---

<Layout title="Internal — Goal Contract gallery">
  <section class="page-head">
    <h1>Goal Contract gallery <span class="int-tag">internal</span></h1>
    <p>Worked examples that exercise the <a href="/spec/GOAL_CONTRACT_v0_1">Goal Contract</a> end to end —
      the three axes (<strong>met</strong> ∧ <strong>governed</strong> ∧ <strong>certified</strong>), every
      evidence-artifact type, goal-scoped governance, and faithfulness. Each opens in the real viewer.
      A coverage check: does the model have everything we need? ({total} examples)</p>
    <p class="int-note">Regenerate with <code>python3 examples/make_goal_gallery.py</code>. The badges are the
      <em>resolved</em> axes from <code>ponens trace enrich</code>, baked in at generation.</p>
    <p class="int-cta"><a href="/internal/walkthrough">▶ Step through a walkthrough</a> — session on the left,
      the trace it produces on the right, with the three axes moving as you step.</p>
  </section>

  {manifest.groups.map((g) => (
    <section class="int-group">
      <h2>{g.group}</h2>
      <div class="int-grid">
        {g.examples.map((ex) => (
          <a class="int-card" href={viewer(ex.file)} target="_blank" rel="noopener">
            <div class="int-axes">
              {[axis("met", ex.axes.met), axis("governed", ex.axes.governed), axis("certified", ex.axes.certified)].map((a) => (
                <span class={"int-axis " + a.cls}><span class="int-mark">{a.mark}</span>{a.label}</span>
              ))}
            </div>
            <h3>{ex.name}</h3>
            <p>{ex.summary}</p>
            <span class="int-open">open in viewer →</span>
          </a>
        ))}
      </div>
    </section>
  ))}
</Layout>

<style>
  .int-tag {
    font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
    color: #fff; background: var(--warn); border-radius: 999px; padding: 0.15rem 0.5rem;
    vertical-align: middle; margin-left: 0.5rem;
  }
  .int-note { font-size: 0.85rem; color: var(--muted); }
  .int-cta { font-size: 0.95rem; margin: 0.6rem 0 0; }
  .int-cta a { color: var(--accent); font-weight: 600; text-decoration: none; }
  .int-cta a:hover { text-decoration: underline; }
  .int-group { margin: 2rem 0 0; }
  .int-group h2 { font-size: 1.15rem; margin: 0 0 0.9rem; letter-spacing: -0.01em; }
  .int-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 0.9rem; }
  .int-card {
    display: block; text-decoration: none; color: inherit;
    background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 1rem;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .int-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .int-card h3 { margin: 0.6rem 0 0.3rem; font-size: 1rem; }
  .int-card p { margin: 0; font-size: 0.88rem; line-height: 1.45; color: var(--muted); }
  .int-axes { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .int-axis {
    display: inline-flex; align-items: center; gap: 0.25rem;
    font-size: 0.68rem; font-weight: 600; border-radius: 999px; padding: 0.12rem 0.5rem;
  }
  .int-axis .int-mark { font-weight: 800; }
  .int-axis.ok { background: rgba(46,160,67,0.16); color: #2da44e; }
  .int-axis.no { background: rgba(207,34,46,0.16); color: #cf222e; }
  .int-axis.na { background: rgba(127,127,127,0.14); color: var(--muted); }
  .int-open { display: inline-block; margin-top: 0.7rem; font-size: 0.82rem; color: var(--accent); }
</style>
