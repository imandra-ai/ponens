---
// The shared Docs-hub shell: the main site chrome (Layout) plus a sticky left sidebar that lists every
// hub section (Getting started · Guides · For agents · Spec). The current section expands to show its
// pages, so /docs, /guides, /agents, and /spec all read as one documentation area. Pass `onThisPage`
// (an array of [anchorId, label]) to add an "On this page" block for a long single page (the tour).
import Layout from "./Layout.astro";
import { sections } from "../data/docsNav.js";

const { title = "Docs — ponens", onThisPage = [] } = Astro.props;

// Enumerate EVERY generated spec page (same source as the /spec index) so the Spec section lists them
// all, and stays complete automatically as specs are added. `prepare.mjs` writes these before build.
const specMods = import.meta.glob("../pages/spec/*.md", { eager: true });
const specPages = Object.values(specMods)
  // Drop the trailing version (e.g. "Trace Spec v1.9" -> "Trace Spec") for the sidebar only — the full
  // versioned title still shows on the /spec index and the page tab.
  .map((m) => ({ href: m.url, label: m.frontmatter.title.replace(/\s+v\d+(?:\.\d+)*$/i, ""),
                 pack: (m.frontmatter.file || "").endsWith("_PACK.md") }))
  .sort((a, b) => a.label.localeCompare(b.label));
// The core specs and the policy PACKS are distinct kinds — list the specs first, then a divided
// "Policy packs" group. Packs are classified by their `_PACK.md` filename, so this stays automatic.
const specCore = specPages.filter((s) => !s.pack);
const specPacks = specPages.filter((s) => s.pack);
const specItems = [
  { href: "/spec", label: "All specifications" },
  ...specCore,
  ...(specPacks.length ? [{ heading: "Policy packs" }, ...specPacks] : []),
];
const navSections = sections.map((s) => (s.id === "spec" ? { ...s, items: specItems } : s));

const norm = (p) => (p.length > 1 && p.endsWith("/") ? p.slice(0, -1) : p);
const here = norm(Astro.url.pathname);
const isActive = (href) => !!href && here === norm(href);   // heading markers have no href
const groupActive = (s) =>
  here === norm(s.href) || here.startsWith(norm(s.href) + "/") || s.items.some((i) => isActive(i.href));
---

<Layout title={title}>
  <div class="docs-shell">
    <aside class="docs-side">
      <p class="docs-side-label">Documentation</p>
      <nav class="docs-side-nav">
        {navSections.map((s) => (
          <div class="docs-side-item">
            <a href={s.href} class:list={["docs-side-link", (isActive(s.href) || groupActive(s)) && "active"]}>
              {s.label}
            </a>
            {groupActive(s) && s.items.length > 0 && (
              <nav class="docs-side-sub">
                {s.items.map((i) => (
                  i.heading
                    ? <p class="docs-side-subhead">{i.heading}</p>
                    : <a href={i.href} class:list={[isActive(i.href) && "active"]}>{i.label}</a>
                ))}
              </nav>
            )}
          </div>
        ))}
      </nav>

      {onThisPage.length > 0 && (
        <div class="docs-side-toc">
          <p class="docs-side-label">On this page</p>
          <nav class="docs-side-sub">
            {onThisPage.map(([id, label]) => <a href={`#${id}`} data-spy={id}>{label}</a>)}
          </nav>
        </div>
      )}
    </aside>

    <div class="docs-body">
      <slot />
    </div>
  </div>
</Layout>
