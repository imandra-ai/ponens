---
import Layout from "../../layouts/Layout.astro";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

// Split-screen, steppable walkthroughs: LEFT = the actions the developer actually performs; RIGHT =
// the ponens trace those actions produce, with the three axes re-resolved on the trace prefix at each
// step. Data is the .walk.json sidecar generated by examples/make_goal_gallery.py (walkthrough_sidecar).
let manifest = { groups: [] };
try {
  manifest = JSON.parse(readFileSync(resolve("../examples/goal-contract/manifest.json"), "utf8"));
} catch (e) { /* generated at build */ }

const wtGroup = manifest.groups.find((g) => g.group === "Walkthroughs");
const walks = (wtGroup?.examples || []).filter((e) => e.walk).map((e) => {
  const data = JSON.parse(readFileSync(resolve(`../examples/goal-contract/${e.walk}`), "utf8"));
  return { name: e.name, trace: e.file, ...data };
});
---

<Layout title="Internal — Walkthroughs">
  <section class="page-head">
    <h1>Walkthroughs <span class="int-tag">internal</span></h1>
    <p>Step through a real session. <strong>Left</strong>: the actions the developer performs.
      <strong>Right</strong>: the ponens trace they produce, with <strong>met · governed · certified</strong>
      re-resolved at every step. Watch the axes move — the counterexample turns <em>governed</em> red;
      the re-proof turns it green again.</p>
  </section>

  <div class="wt" data-walks={JSON.stringify(walks)}>
    <div class="wt-tabs" id="wtTabs"></div>
    <div class="wt-split">
      <div class="wt-pane wt-left">
        <div class="wt-pane-h">What the developer does</div>
        <div id="wtSteps"></div>
      </div>
      <div class="wt-gutter" id="wtGutter" role="separator" aria-orientation="vertical"
           title="Drag to resize"></div>
      <div class="wt-pane wt-right">
        <div class="wt-pane-h">The trace it produces
          <span class="wt-axes-inline" id="wtAxes"></span>
        </div>
        <iframe id="wtViewer" class="wt-viewer" title="ponens trace viewer"></iframe>
      </div>
    </div>
    <div class="wt-controls">
      <button id="wtPrev" class="wt-btn">← prev</button>
      <span id="wtProgress" class="wt-progress"></span>
      <button id="wtNext" class="wt-btn">next →</button>
      <a id="wtOpen" class="wt-open" target="_blank" rel="noopener">open full trace in viewer ↗</a>
    </div>
  </div>
</Layout>

<script>
  const root = document.querySelector(".wt");
  const walks = JSON.parse(root.dataset.walks || "[]");
  let si = 0, ti = 0;

  const axisPill = (label, v) => {
    const cls = v === null || v === undefined ? "na" : v ? "ok" : "no";
    const mark = cls === "na" ? "–" : cls === "ok" ? "✓" : "✗";
    return `<span class="wt-axis ${cls}"><b>${mark}</b> ${label}</span>`;
  };

  let loadedTrace = null;
  const iframe = () => document.getElementById("wtViewer");

  function postFocus(metaId, withRetries) {
    const send = () => { try { iframe().contentWindow.postMessage({ type: "ponens:focus", metaId }, "*"); } catch (e) {} };
    send();
    if (withRetries) [250, 600, 1200].forEach((t) => setTimeout(send, t)); // cover the viewer's async trace fetch
  }

  // Drive the embedded FULL viewer: (re)load the trace on story change, then focus the current step.
  function syncViewer() {
    const w = walks[si];
    const metaId = w.steps[ti].id;
    if (loadedTrace !== w.trace) {
      loadedTrace = w.trace;
      iframe().onload = () => postFocus(metaId, true);
      iframe().src = `/viewer/visualizer.html?trace=demo-traces/goal-contract/${w.trace}`;
    } else {
      postFocus(metaId, false);
    }
  }

  function render() {
    const w = walks[si];
    if (!w) return;
    document.getElementById("wtTabs").innerHTML = walks
      .map((x, i) => `<button class="wt-tab ${i === si ? "active" : ""}" data-s="${i}">${x.name}</button>`)
      .join("");
    document.getElementById("wtSteps").innerHTML = w.steps.map((s, i) => `
      <div class="wt-step ${i === ti ? "cur" : i < ti ? "done" : ""}" data-t="${i}">
        <div class="wt-step-h"><span class="wt-step-n">${s.id}</span>${s.title}</div>
        <div class="wt-acts">${s.actions.map((a) => `
          <div class="wt-act">
            <span class="wt-atype">${a.type}</span>
            <span class="wt-alabel">${a.label || ""}</span>
            ${a.result ? `<span class="wt-ares ${/refut|fail/i.test(a.result) ? "bad" : /prov|pass/i.test(a.result) ? "good" : ""}">${a.result}</span>` : ""}
          </div>`).join("")}</div>
      </div>`).join("");
    // compact evolving axes in the pane header (the one thing the full viewer can't show per-step)
    const ax = w.steps[ti].axes_after;
    document.getElementById("wtAxes").innerHTML =
      axisPill("met", ax.met) + axisPill("governed", ax.governed) + axisPill("certified", ax.certified);
    document.getElementById("wtProgress").textContent = `step ${ti + 1} of ${w.steps.length}`;
    document.getElementById("wtPrev").disabled = ti === 0;
    document.getElementById("wtNext").disabled = ti === w.steps.length - 1;
    document.getElementById("wtOpen").href = `/viewer/visualizer.html?trace=demo-traces/goal-contract/${w.trace}`;
    syncViewer();
  }

  root.addEventListener("click", (e) => {
    const tab = e.target.closest(".wt-tab"); if (tab) { si = +tab.dataset.s; ti = 0; return render(); }
    const step = e.target.closest(".wt-step"); if (step) { ti = +step.dataset.t; return render(); }
    if (e.target.id === "wtPrev" && ti > 0) { ti--; return render(); }
    if (e.target.id === "wtNext" && ti < walks[si].steps.length - 1) { ti++; return render(); }
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft" && ti > 0) { ti--; render(); }
    if (e.key === "ArrowRight" && ti < walks[si].steps.length - 1) { ti++; render(); }
  });

  // Draggable splitter: move the border between the session (left) and the viewer (right).
  const split = document.querySelector(".wt-split");
  const gutter = document.getElementById("wtGutter");
  let dragging = false;
  gutter.addEventListener("mousedown", (e) => { dragging = true; split.classList.add("dragging"); e.preventDefault(); });
  window.addEventListener("mousemove", (e) => {
    if (!dragging) return;
    const rect = split.getBoundingClientRect();
    const left = Math.max(260, Math.min(e.clientX - rect.left, rect.width - 380)); // keep both panes usable
    split.style.gridTemplateColumns = `${left}px 10px 1fr`;
  });
  window.addEventListener("mouseup", () => { if (dragging) { dragging = false; split.classList.remove("dragging"); } });

  render();
</script>

<!-- is:global — the step/action items are injected via innerHTML in the client script, so they never
     receive Astro's scoped-style attribute. Global (wt-* prefixed) rules reach the dynamic content. -->
<style is:global>
  .int-tag { font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
    color: #fff; background: var(--warn); border-radius: 999px; padding: 0.15rem 0.5rem;
    vertical-align: middle; margin-left: 0.5rem; }
  /* Break out of the centered 1040px column to full viewport width. */
  .wt { width: 100vw; margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw);
    padding: 0 2rem; box-sizing: border-box; }
  .wt-tabs { display: flex; gap: 0.5rem; margin: 0.5rem 0 1rem; flex-wrap: wrap; }
  .wt-tab { font: inherit; font-size: 0.85rem; padding: 0.4rem 0.8rem; border-radius: 8px;
    border: 1px solid var(--border); background: var(--panel); color: var(--muted); cursor: pointer; }
  .wt-tab.active { border-color: var(--accent); color: var(--fg); font-weight: 600; }
  .wt-split { display: grid; grid-template-columns: 42% 10px 1fr; align-items: start; }
  .wt-gutter { align-self: stretch; min-height: 240px; cursor: col-resize; border-radius: 4px;
    background: var(--border); position: relative; transition: background 0.12s ease; }
  .wt-gutter::before { content: ""; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 2px; height: 26px; border-radius: 2px; background: var(--muted); opacity: 0.5; }
  .wt-gutter::after { content: ""; position: absolute; inset: 0 -6px; }  /* widen the grab target */
  .wt-gutter:hover, .wt-split.dragging .wt-gutter { background: var(--accent); }
  .wt-split.dragging { user-select: none; cursor: col-resize; }
  .wt-split.dragging iframe { pointer-events: none; }
  @media (max-width: 820px) { .wt-split { grid-template-columns: 1fr; } .wt-gutter { display: none; } }
  .wt-pane { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
  .wt-pane-h { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--muted); padding: 0.6rem 0.9rem; border-bottom: 1px solid var(--border);
    background: rgba(127,127,127,0.05); display: flex; align-items: center; justify-content: space-between; }
  .wt-axes-inline { display: inline-flex; gap: 0.3rem; }
  .wt-axes-inline .wt-axis { font-size: 0.66rem; padding: 0.1rem 0.5rem; text-transform: none; letter-spacing: 0; font-weight: 600; }
  .wt-viewer { width: 100%; height: 620px; border: 0; display: block; background: var(--bg); }
  .wt-right { display: flex; flex-direction: column; }
  /* left: steps — solid horizontal dividers between each; dim CONTENT (not the divider) by state */
  .wt-step { padding: 0.85rem 0.9rem; border-bottom: 1px solid var(--border); cursor: pointer;
    transition: background 0.12s ease; }
  .wt-step:last-child { border-bottom: 0; }
  .wt-step .wt-step-h, .wt-step .wt-acts { opacity: 0.55; transition: opacity 0.12s ease; }
  .wt-step.done .wt-step-h, .wt-step.done .wt-acts { opacity: 0.82; }
  .wt-step:hover:not(.cur) { background: rgba(127,127,127,0.06); }
  .wt-step.cur { background: rgba(110,168,254,0.08); box-shadow: inset 3px 0 0 var(--accent); }
  .wt-step.cur .wt-step-h, .wt-step.cur .wt-acts { opacity: 1; }
  .wt-step-h { font-weight: 650; font-size: 0.95rem; display: flex; align-items: center; gap: 0.5rem; color: var(--fg); }
  .wt-step-n { font-size: 0.62rem; font-weight: 700; color: #fff; background: var(--accent);
    border-radius: 5px; padding: 0.1rem 0.35rem; }
  .wt-acts { margin-top: 0.45rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .wt-act { display: flex; align-items: center; gap: 0.55rem; font-size: 0.82rem;
    padding: 0.15rem 0; }
  .wt-atype { font-family: ui-monospace, monospace; font-size: 0.68rem; font-weight: 700; color: var(--accent-2);
    background: rgba(157,123,255,0.12); border-radius: 5px; padding: 0.12rem 0.4rem; min-width: 78px;
    text-align: center; flex: none; }
  .wt-alabel { color: var(--fg); flex: 1; }
  .wt-ares { font-size: 0.72rem; font-weight: 600; color: var(--muted); }
  .wt-ares.bad { color: #cf222e; } .wt-ares.good { color: #2da44e; }
  /* right */
  .wt-axes { display: flex; gap: 0.4rem; padding: 0.9rem; flex-wrap: wrap; }
  .wt-axis { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.8rem; font-weight: 600;
    border-radius: 999px; padding: 0.2rem 0.7rem; }
  .wt-axis b { font-weight: 800; }
  .wt-axis.ok { background: rgba(46,160,67,0.16); color: #2da44e; }
  .wt-axis.no { background: rgba(207,34,46,0.16); color: #cf222e; }
  .wt-axis.na { background: rgba(127,127,127,0.14); color: var(--muted); }
  .wt-sub { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--muted); padding: 0.3rem 0.9rem; }
  .wt-arts { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0 0.9rem 0.6rem; }
  .wt-art { font-size: 0.75rem; color: var(--muted); border: 1px solid var(--border); border-radius: 6px;
    padding: 0.15rem 0.45rem; display: inline-flex; gap: 0.3rem; align-items: center; }
  .wt-art code { color: var(--fg); }
  .wt-art.fresh { border-color: var(--accent); color: var(--fg); background: rgba(110,168,254,0.1); }
  .wt-empty { font-size: 0.8rem; color: var(--muted); padding: 0 0.9rem 0.6rem; }
  .wt-res { font-size: 0.82rem; color: var(--muted); padding: 0.3rem 0.9rem 0.6rem; line-height: 1.4; }
  .wt-res-sev { font-size: 0.66rem; font-weight: 700; border-radius: 5px; padding: 0.1rem 0.4rem;
    margin-right: 0.45rem; background: rgba(169,121,15,0.16); color: var(--warn); }
  .wt-res-sev.high { background: rgba(207,34,46,0.16); color: #cf222e; }
  /* controls */
  .wt-controls { display: flex; align-items: center; gap: 0.9rem; margin: 1rem 0 0; }
  .wt-btn { font: inherit; font-size: 0.85rem; padding: 0.4rem 0.9rem; border-radius: 8px;
    border: 1px solid var(--border); background: var(--panel); color: var(--fg); cursor: pointer; }
  .wt-btn:disabled { opacity: 0.4; cursor: default; }
  .wt-progress { font-size: 0.85rem; color: var(--muted); }
  .wt-open { margin-left: auto; font-size: 0.82rem; color: var(--accent); text-decoration: none; }
</style>
