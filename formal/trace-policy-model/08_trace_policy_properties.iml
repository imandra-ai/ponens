(* 08_trace_policy_properties.iml *)

[@@@import Policy_types, "01_trace_policy_types.iml"]
[@@@import Policy_utils, "02_trace_policy_utils.iml"]
[@@@import Policy_accessors, "03_trace_policy_accessors.iml"]
[@@@import Policy_binding, "04_trace_policy_binding.iml"]

open Policy_types
open Policy_utils
open Policy_accessors
open Policy_binding

let rec all_action_inputs_exist (tr : trace) (xs : action list) : bool =
  match xs with
  | [] -> true
  | x :: rest ->
    let c = action_common_of x in
    let rec inputs_exist ys =
      match ys with
      | [] -> true
      | y :: ys_rest ->
        begin match find_artifact_by_id y tr.artifacts with
        | Some _ -> inputs_exist ys_rest
        | None -> false
        end
    in
    inputs_exist c.inputs && all_action_inputs_exist tr rest

let rec all_action_outputs_exist (tr : trace) (xs : action list) : bool =
  match xs with
  | [] -> true
  | x :: rest ->
    let c = action_common_of x in
    let rec outputs_exist ys =
      match ys with
      | [] -> true
      | y :: ys_rest ->
        begin match find_artifact_by_id y tr.artifacts with
        | Some _ -> outputs_exist ys_rest
        | None -> false
        end
    in
    outputs_exist c.outputs && all_action_outputs_exist tr rest

let rec all_producer_action_ids_exist (tr : trace) (xs : artifact list) : bool =
  match xs with
  | [] -> true
  | x :: rest ->
    begin match (artifact_common_of x).producer_action_id with
    | Some id ->
      begin match find_action_by_id id tr.actions with
      | Some _ -> all_producer_action_ids_exist tr rest
      | None -> false
      end
    | None -> all_producer_action_ids_exist tr rest
    end
let rec all_producer_action_ids_match_outputs (tr : trace) (xs : artifact list) : bool =
  match xs with
  | [] -> true
  | x :: rest ->
    begin match (artifact_common_of x).producer_action_id with
    | Some id ->
      begin match find_action_by_id id tr.actions with
      | Some a ->
        mem_string (artifact_id_of x) (action_common_of a).outputs
        && all_producer_action_ids_match_outputs tr rest
      | None -> false
      end
    | None -> all_producer_action_ids_match_outputs tr rest
    end

let rec all_derived_from_exist (tr : trace) (xs : artifact list) : bool =
  match xs with
  | [] -> true
  | x :: rest ->
    let rec parents_exist ys =
      match ys with
      | [] -> true
      | y :: ys_rest ->
        begin match find_artifact_by_id y tr.artifacts with
        | Some _ -> parents_exist ys_rest
        | None -> false
        end
    in
    parents_exist (artifact_common_of x).derived_from && all_derived_from_exist tr rest

let wf_trace (tr : trace) : bool =
  unique_ints (action_ids_of tr.actions)
  && unique_strings (artifact_ids_of tr.artifacts)
  && all_action_inputs_exist tr tr.actions
  && all_action_outputs_exist tr tr.actions
  && all_producer_action_ids_exist tr tr.artifacts
  && all_producer_action_ids_match_outputs tr tr.artifacts
  && all_derived_from_exist tr tr.artifacts

let rec all_actions_have_rationale_actions (xs : action list) : bool =
  match xs with
  | [] -> true
  | x :: rest -> action_has_nonempty_rationale x && all_actions_have_rationale_actions rest

let all_actions_have_rationale (tr : trace) : bool =
  all_actions_have_rationale_actions tr.actions

let rec tests_before_commit_aux (seen_tests : bool) (xs : action list) : bool =
  match xs with
  | [] -> true
  | x :: rest ->
    begin match x with
    | ActivityAction (_, RunTests, _) -> tests_before_commit_aux true rest
    | ActivityAction (_, GitCommit, _) -> seen_tests && tests_before_commit_aux seen_tests rest
    | _ -> tests_before_commit_aux seen_tests rest
    end
[@@measure Ordinal.of_int (List.length xs)]

let tests_before_commit (tr : trace) : bool =
  tests_before_commit_aux false tr.actions

let goals_reference_valid_artifacts (tr : trace) : bool =
  let rec go xs =
    match xs with
    | [] -> true
    | x :: rest ->
      begin match x with
      | VerificationGoalArtifact (_, vg) ->
        begin match find_artifact_by_id vg.target_artifact_id tr.artifacts with
        | Some a -> is_formal_model_artifact a && go rest
        | None -> false
        end
      | _ -> go rest
      end
  in go tr.artifacts

let generated_tests_require_state_space_analysis (tr : trace) : bool =
  let rec go xs =
    match xs with
    | [] -> true
    | x :: rest ->
      begin match x with
      | GeneratedTestsArtifact (c, _) ->
        let rec exists_analysis ys =
          match ys with
          | [] -> false
          | y :: ys_rest ->
            if is_state_space_analysis_result_artifact y
               && (artifact_id_of y = c.artifact_id
                   || ancestor_of_artifact (artifact_id_of y) c.artifact_id tr.artifacts)
            then true
            else exists_analysis ys_rest
        in
        exists_analysis tr.artifacts && go rest
      | _ -> go rest
      end
  in go tr.artifacts

(* ── Freshness soundness (TRACE_SPEC §18.3) ───────────────────────────────────
   Universal properties of `freshness_of` / `counts_as_evidence` (03_accessors). Each is a
   verification goal: it should hold for ALL (stored, current) fingerprints. Together they pin the
   guarantee that a reasoning result NEVER counts as evidence unless it is provably Fresh — the
   formal counterpart to the §18.2 rule "only a Fresh proved result resolves a Property AcceptDone".
   `current = None` models the target symbol being absent from the current model. *)

(* Fresh is granted only on an exact task-checksum match with an unchanged engine and a present target. *)
let prop_fresh_implies_task_match (stored : reasoning_fingerprint)
                                  (current : reasoning_fingerprint option) : bool =
  match freshness_of stored current with
  | Fresh ->
    begin match current with
    | Some cur -> cur.task_checksum = stored.task_checksum && not (engine_changed stored cur)
    | None -> false   (* unreachable: current = None forces Detached *)
    end
  | Stale | Detached -> true

(* Detached is granted EXACTLY when the target no longer exists in the current model. *)
let prop_detached_iff_target_absent (stored : reasoning_fingerprint)
                                    (current : reasoning_fingerprint option) : bool =
  (freshness_of stored current = Detached) = (current = None)

(* The headline guarantee: a Stale or Detached result never counts as evidence. *)
let prop_stale_or_detached_not_evidence (stored : reasoning_fingerprint)
                                        (current : reasoning_fingerprint option) : bool =
  match freshness_of stored current with
  | Stale | Detached -> not (counts_as_evidence stored current)
  | Fresh -> true

(* And the converse: a result counts as evidence iff it is Fresh. *)
let prop_evidence_iff_fresh (stored : reasoning_fingerprint)
                            (current : reasoning_fingerprint option) : bool =
  counts_as_evidence stored current = (freshness_of stored current = Fresh)

(* ── Acceptance × freshness (TRACE_SPEC §18.2 / §18.3) ────────────────────────
   The gap this closes: "no AcceptDone over Stale/Detached evidence", now stated directly over the
   §18.2 resolution rule (resolve_property_status, 03_accessors) rather than only at the
   counts_as_evidence level. *)

(* A Property acceptance item resolves AcceptDone only if its backing result is Fresh. *)
let prop_property_done_requires_fresh (rs : verification_result_status) (fr : freshness) : bool =
  not (resolve_property_status rs fr = AcceptDone) || (fr = Fresh)

(* … and only if its backing result is proved. *)
let prop_property_done_requires_proved (rs : verification_result_status) (fr : freshness) : bool =
  not (resolve_property_status rs fr = AcceptDone) || (rs = VrProved)

(* THE HEADLINE, end to end: a Property item whose backing result (stored fingerprint `stored`, vs the
   current model fingerprint `current`) resolves AcceptDone must have a result that counts as evidence
   — i.e. is Fresh. Composes resolve_property_status ∘ freshness_of, so a Stale or Detached result can
   never carry a goal to done. *)
let prop_no_acceptdone_over_nonfresh
    (rs : verification_result_status)
    (stored : reasoning_fingerprint)
    (current : reasoning_fingerprint option) : bool =
  not (resolve_property_status rs (freshness_of stored current) = AcceptDone)
  || counts_as_evidence stored current

(* ── Counter-evidence (TRACE_SPEC §13 Defeater / §18.2) ───────────────────────
   An OPEN Defeater contesting a result blocks it: a contested proof is never Done, whatever its
   status/freshness — the negative-evidence dual of the freshness guarantee above. *)

(* A contested Property never resolves AcceptDone… *)
let prop_contested_never_done (rs : verification_result_status) (fr : freshness)
                              (contested : bool) : bool =
  not contested || not (resolve_property_status_contested rs fr contested = AcceptDone)

(* …it resolves AcceptBlocked, exactly as a refutation does. *)
let prop_contested_is_blocked (rs : verification_result_status) (fr : freshness)
                              (contested : bool) : bool =
  not contested || (resolve_property_status_contested rs fr contested = AcceptBlocked)
