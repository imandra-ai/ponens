(* Goals: the met axis, a query over the state
   =========================================== *)

[@@@import Core, "core.iml"]
[@@@import Freshness, "freshness.iml"]

open Core
open Artifact
open Trace

(* An acceptance item targets a code component; its resolved status is a query over the
   trace's evidence. Done = a live (current) verification result roots in the component;
   the honesty overlay flags a Done item whose evidence has drifted (no longer fresh)
   as at_risk without demoting its status. `met` = every item Done (all-done). This is
   the "met" axis of the evidence logic, built directly on the freshness query (I4). *)
type gstatus = GTodo | GDoing | GDone | GBlocked

type gitem = { comp : int }

let rec mem_gitem (it : gitem) (g : gitem list) : bool =
  match g with [] -> false | x :: r -> x = it || mem_gitem it r

(* is there a live (current) verification result for this component? (evidence exists) *)
let rec has_live_result_for (t : trace) (comp : int) : bool =
  match t with
  | [] -> false
  | a :: r -> (Freshness.is_live_result a && a.target = comp) || has_live_result_for r comp

(* resolve an item against the state: Done iff a live result roots in its component *)
let resolve_item (t : trace) (it : gitem) : gstatus =
  if has_live_result_for t it.comp then GDone else GTodo

(* the honesty overlay: a Done item whose live evidence is no longer fresh is flagged
   at_risk. It composes the resolved status with the freshness query (I4). *)
let item_at_risk (t : trace) (it : gitem) (present : int -> bool) (cur : int -> int) : bool =
  resolve_item t it = GDone
  && not (Freshness.has_fresh_result t it.comp present cur)

let rec goal_met (t : trace) (g : gitem list) : bool =
  match g with
  | [] -> true
  | it :: rest -> (resolve_item t it = GDone) && goal_met t rest

(* Progress is a real ratio in [0,1]
   --------------------------------- *)

(* progress = resolved / total as a real fraction (goals.py progress_of). The bound
   "progress in [0,1]" is discharged via RCF by abstracting the quotient; integer
   a*100/b would not go through. *)
let rec g_resolved (t : trace) (g : gitem list) : int =
  match g with
  | [] -> 0
  | it :: rest -> (if resolve_item t it = GDone then 1 else 0) + g_resolved t rest

let rec g_total (g : gitem list) : int =
  match g with [] -> 0 | _ :: rest -> 1 + g_total rest

let g_progress (t : trace) (g : gitem list) : real =
  if g_total g = 0 then 0.
  else Real.( of_int (g_resolved t g) / of_int (g_total g) )

(* G1 met is all-done: a met goal has every item resolved Done. *)
theorem met_all_done (t : trace) (g : gitem list) (it : gitem) =
  goal_met t g && mem_gitem it g ==> resolve_item t it = GDone
[@@by induct ()]

(* G2 Done is evidence-grounded: an item resolves Done only when a live result really
   roots in its component, never from prose (this is I3 at the goal layer). *)
theorem done_needs_evidence (t : trace) (it : gitem) =
  resolve_item t it = GDone ==> has_live_result_for t it.comp
[@@by auto]

(* G3 at_risk never demotes: an at-risk item is still Done. The overlay only sets a
   flag; it does not change the resolved status (goals.py enrich only writes at_risk). *)
theorem at_risk_never_demotes (t : trace) (it : gitem) (present : int -> bool) (cur : int -> int) =
  item_at_risk t it present cur ==> resolve_item t it = GDone
[@@by auto]

(* G4 honesty (composition with freshness): a Done item that is not at_risk has fresh
   evidence, so "green and not at risk" can never hide stale evidence. This is
   no-false-fresh lifted to the met axis. *)
theorem done_not_at_risk_is_fresh (t : trace) (it : gitem) (present : int -> bool) (cur : int -> int) =
  resolve_item t it = GDone && not (item_at_risk t it present cur)
  ==> Freshness.has_fresh_result t it.comp present cur
[@@by auto]

lemma g_resolved_nonneg (t : trace) (g : gitem list) =
  0 <= g_resolved t g
[@@by induct ()]

lemma g_total_nonneg (g : gitem list) =
  0 <= g_total g
[@@by induct ()]

lemma g_resolved_le_total (t : trace) (g : gitem list) =
  g_resolved t g <= g_total g
[@@by induct ()]

lemma div_recip (x : real) (y : real) =
  Real.( y <> 0. ) ==> Real.( y * (x / y) = x )
[@@by auto]

lemma ratio_from_prod (x : real) (y : real) (q : real) =
  Real.( 0. <= x && x <= y && y > 0. && y * q = x ) ==> Real.( 0. <= q && q <= 1. )
[@@by auto]

lemma real_ratio_bounded (x : real) (y : real) =
  Real.( 0. <= x && x <= y && y > 0. ) ==> Real.( 0. <= x / y && x / y <= 1. )
[@@by [%use div_recip x y] @> [%use ratio_from_prod x y Real.(x / y)] @> auto]

lemma of_int_nonneg (a : int) = 0 <= a ==> Real.( of_int a >= 0. )
[@@by auto]

lemma of_int_mono (a : int) (b : int) = a <= b ==> Real.( of_int a <= of_int b )
[@@by auto]

lemma of_int_pos (b : int) = 0 < b ==> Real.( of_int b > 0. )
[@@by auto]

(* progress lands in [0.,1.] on a non-empty goal. *)
theorem g_progress_bounded (t : trace) (g : gitem list) =
  g_total g > 0 ==> Real.( 0. <= g_progress t g && g_progress t g <= 1. )
[@@by [%use g_resolved_nonneg t g] @> [%use g_resolved_le_total t g]
   @> [%use of_int_nonneg (g_resolved t g)]
   @> [%use of_int_mono (g_resolved t g) (g_total g)]
   @> [%use of_int_pos (g_total g)]
   @> [%use real_ratio_bounded (Real.of_int (g_resolved t g)) (Real.of_int (g_total g))]
   @> auto]

theorem g_progress_wf (t : trace) (g : gitem list) =
  g_total g = 0 ==> Real.( g_progress t g = 0. )
[@@by auto]
